# LLM providers
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Claude via the local cursor-proxy (default for orchestrator, test generator and reviewer). It takes OpenAI-format
# requests and forwards them to Anthropic using the Claude Code OAuth session — no Anthropic key.
#   cd ~/cursor-proxy
# Needs cursor-proxy >= 0.2.0 (older versions silently drop system prompts).
#   node dist/cli.js import-claude-code   # if there is no session yet
#   node dist/cli.js install-service      # macOS launch agent
# The key (cpx_…) is printed once by `node dist/cli.js key`. Model names: cpxopus/cpxsonnet/cpxhaiku.
CLAUDE_PROXY_URL=http://127.0.0.1:8787/v1
CLAUDE_PROXY_KEY=

# Role → model (fallback is used when the primary errors out)
ORCHESTRATOR_MODEL=cpxopus
REVIEWER_MODEL=cpxopus
TEST_GENERATOR_MODEL=cpxopus
CODER_MODEL=deepseek-v4-flash
FALLBACK_MODEL=claude-sonnet-5

# Infra
DATABASE_URL=postgresql://agentflow:agentflow@localhost:5432/agentflow
REDIS_URL=redis://localhost:6379
# Required outside docker-compose: empty secrets refuse requests unless INSECURE_DEV=true
API_TOKEN=

# GitHub (clone target repo, open PR, webhook trigger)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_TRIGGER_LABEL=agentflow

# Telegram (notifications + approve/reject buttons for HITL)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# webhook (needs a public URL → /webhooks/telegram) or polling (docker-compose default: works on a laptop)
TELEGRAM_MODE=webhook

# MCP over HTTP (uv run agentflow-mcp --http) refuses requests without this bearer token
MCP_TOKEN=
# Repos MCP runs may target (copy repos.example.toml)
# JS_RUNNER_DIR=~/.cache/agentflow/js-runner  # the TS gate's own vitest (the Docker image ships one)
REPOS_FILE=repos.toml
# Host port of compose's Redis, if 6379 is taken; then also REDIS_URL=redis://localhost:<port> for MCP
# REDIS_PORT=6380

# Chat layer (chat/): a second bot on long polling; reuses CLAUDE_PROXY_* and MCP_TOKEN above
CHAT_TELEGRAM_BOT_TOKEN=
CHAT_ALLOWED_CHAT_IDS=

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentflow
