# LLM providers
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
VOYAGE_API_KEY=

# Role → model (fallback is used when the primary errors out)
ORCHESTRATOR_MODEL=claude-opus-5
REVIEWER_MODEL=claude-opus-5
TEST_GENERATOR_MODEL=claude-opus-5
CODER_MODEL=deepseek-v4-flash
FALLBACK_MODEL=claude-sonnet-5

# Infra
DATABASE_URL=postgresql://agentflow:agentflow@localhost:5432/agentflow
REDIS_URL=redis://localhost:6379
API_TOKEN=

# GitHub (clone target repo, open PR, webhook trigger)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_TRIGGER_LABEL=agentflow

# Telegram (notifications + approve/reject buttons for HITL)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentflow
